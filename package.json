{
  "name": "plataforma-kit",
  "version": "1.1.0",
  "description": "Base comum dos módulos da plataforma (Cronogramas, Orçamentos, C.P): login local ou pelo portal, sessão, permissões, erros, migrações, base de servidor e peças de tela",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    "./erros": {
      "types": "./dist/erros.d.ts",
      "default": "./dist/erros.js"
    },
    "./permissoes": {
      "types": "./dist/permissoes.d.ts",
      "default": "./dist/permissoes.js"
    },
    "./sessao": {
      "types": "./dist/sessao.d.ts",
      "default": "./dist/sessao.js"
    },
    "./portal": {
      "types": "./dist/portal.d.ts",
      "default": "./dist/portal.js"
    },
    "./seguranca": {
      "types": "./dist/seguranca.d.ts",
      "default": "./dist/seguranca.js"
    },
    "./autenticacao": {
      "types": "./dist/autenticacao.d.ts",
      "default": "./dist/autenticacao.js"
    },
    "./migrador": {
      "types": "./dist/migrador.d.ts",
      "default": "./dist/migrador.js"
    },
    "./tipos": {
      "types": "./dist/tipos.d.ts",
      "default": "./dist/tipos.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "default": "./dist/prettier.js"
    }
  },
  "files": [
    "dist",
    "estilos",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.testes.json",
    "test": "vitest run",
    "lint": "npm run build && eslint .",
    "formatar": "prettier --write .",
    "formatacao": "prettier --check ."
  },
  "peerDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fastify": "^5.0.0",
    "globals": "*",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fastify": "^5.12.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "@eslint/js": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-config-prettier": {
      "optional": true
    },
    "globals": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infracommerce/plataforma-kit.git"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
